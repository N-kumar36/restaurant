# Database Configuration (MySQL)
DB_ROOT_PASSWORD=restaurant_root_password
DB_NAME=restaurant_db
DB_USER=restaurant_user
DB_PASSWORD=restaurant_password
DATABASE_URL=mysql://restaurant_user:restaurant_password@localhost:3306/restaurant_db

# Backend API Configuration
NODE_ENV=development
PORT=5000
JWT_SECRET=super_secret_jwt_key_restaurant_2026_dev_env
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Online Payment (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=rzp_test_your_secret_key

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

